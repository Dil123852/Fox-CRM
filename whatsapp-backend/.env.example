# PostgreSQL Database
DATABASE_URL=postgresql://crm:crm_secret@localhost:5432/crm

# Anthropic / Claude API
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# WhatsApp Business API (Meta/Facebook)
WHATSAPP_TOKEN=your-permanent-whatsapp-access-token
# Meta Cloud API sender id. Optional — defaults to the number already in code.
PHONE_NUMBER_ID=
VERIFY_TOKEN=your-webhook-verify-token
# Meta app secret — used to verify the X-Hub-Signature-256 on POST /webhook.
# REQUIRED for the Meta channel: without it that webhook rejects every request.
META_APP_SECRET=

# Twilio WhatsApp Sandbox
# Find these at https://console.twilio.com — Account SID/Auth Token on the dashboard,
# sandbox number under Messaging > Try it out > Send a WhatsApp message
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Set to false to skip X-Twilio-Signature validation (sandbox/local tunneling only)
TWILIO_VALIDATE_SIGNATURE=true

# Server Configuration
PORT=3000
NODE_ENV=development

# Staff auth (Phase 1 / Module 2) — sign with a long random value in any real deployment
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated list of origins allowed to call the staff API (dashboard's
# real URL(s)). Public promo-code endpoints are always open regardless of this.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Call tracker Android app. Phones now sign in with each agent's own CRM login
# and get their own key (migration 050), so this shared key is only for app
# builds from BEFORE that — and it is extractable from those APKs. It is
# REFUSED unless CALL_TRACKER_ALLOW_LEGACY_KEY=true; switch that on only while
# the last phones are updated, then off again. Rotate the key if it leaked.
CALL_TRACKER_API_KEY=change-me-to-a-long-random-string
CALL_TRACKER_ALLOW_LEGACY_KEY=false

# Click-to-call safety limits (defaults shown). The phone dials with no tap,
# so these bound what a stolen login could do with it.
#   DIAL_ALLOWED_PREFIXES  country codes that may be dialled, comma-separated
#   DIAL_MAX_PER_HOUR      calls from the CRM per agent per hour
#   DEVICE_TOKEN_IDLE_DAYS a phone silent this long is signed out
DIAL_ALLOWED_PREFIXES=94
DIAL_MAX_PER_HOUR=60
DEVICE_TOKEN_IDLE_DAYS=30
