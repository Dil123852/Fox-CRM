# ── Root compose env ─────────────────────────────────────────────────────────
# docker-compose.yml interpolates these. Copy to `.env` before building.

# Where the BROWSER should send API calls. Baked into the frontend bundle at
# BUILD time (Vite substitutes import.meta.env at build, not at runtime), so
# changing it requires a frontend rebuild, not just a restart.
#
# Leave it EMPTY for the normal deployment: the app then uses same-origin
# relative URLs (/api/...) which nginx proxies to the backend container
# (see whatsapp-dashboard/nginx.conf). Set it only if the API is served from
# a different host/port than the dashboard.
#
# It must be present-but-empty, not missing: an UNSET value makes the code
# fall back to http://localhost:3000, which gets compiled into the bundle and
# sends every visitor's browser to their OWN machine instead of the server.
VITE_BACKEND_URL=

# Origins allowed to call the API cross-origin. Not needed when the dashboard
# is served same-origin through nginx (the normal case above).
CORS_ALLOWED_ORIGINS=

POSTGRES_PASSWORD=change_me
JWT_SECRET=change_me
ANTHROPIC_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_VALIDATE_SIGNATURE=true
WHATSAPP_TOKEN=
VERIFY_TOKEN=
CALL_TRACKER_API_KEY=
